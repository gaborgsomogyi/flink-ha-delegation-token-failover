<project xmlns="http://maven.apache.org/POM/4.0.0"
		 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

	<modelVersion>4.0.0</modelVersion>

	<groupId>com.example.flink</groupId>
	<artifactId>flink-ha-delegation-token-failover</artifactId>
	<version>1.0-SNAPSHOT</version>
	<packaging>pom</packaging>

	<name>flink-ha-delegation-token-failover</name>
	<description>
		Failover and endurance test of Flink delegation tokens in a high availability setup:
		a mock token plugin plus a driver which runs a real cluster in Docker, kills leaders and
		asserts on facts.
	</description>

	<licenses>
		<license>
			<name>The Apache Software License, Version 2.0</name>
			<url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
			<distribution>repo</distribution>
		</license>
	</licenses>

	<modules>
		<module>plugin</module>
		<module>driver</module>
	</modules>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

		<!-- The plugin only needs the delegation token and file system SPI of flink-core. The SPI
			 is stable across the Flink 2.x line, build against a snapshot with
			 -Dflink.version=2.5-SNAPSHOT. -->
		<flink.version>2.3.0</flink.version>
		<slf4j.version>1.7.36</slf4j.version>
		<jackson.version>2.18.3</jackson.version>
		<junit.jupiter.version>5.10.3</junit.jupiter.version>
		<assertj.version>3.27.3</assertj.version>

		<maven.compiler.plugin.version>3.13.0</maven.compiler.plugin.version>
		<maven.surefire.plugin.version>3.2.2</maven.surefire.plugin.version>
		<maven.jar.plugin.version>3.4.2</maven.jar.plugin.version>
		<maven.shade.plugin.version>3.5.3</maven.shade.plugin.version>
		<maven.resources.plugin.version>3.3.1</maven.resources.plugin.version>
		<maven.clean.plugin.version>3.3.2</maven.clean.plugin.version>
		<spotless.version>2.43.0</spotless.version>
	</properties>

	<build>
		<pluginManagement>
			<plugins>
				<plugin>
					<artifactId>maven-compiler-plugin</artifactId>
					<version>${maven.compiler.plugin.version}</version>
				</plugin>
				<plugin>
					<artifactId>maven-surefire-plugin</artifactId>
					<version>${maven.surefire.plugin.version}</version>
				</plugin>
				<plugin>
					<artifactId>maven-jar-plugin</artifactId>
					<version>${maven.jar.plugin.version}</version>
				</plugin>
				<plugin>
					<artifactId>maven-shade-plugin</artifactId>
					<version>${maven.shade.plugin.version}</version>
				</plugin>
				<plugin>
					<artifactId>maven-resources-plugin</artifactId>
					<version>${maven.resources.plugin.version}</version>
				</plugin>
				<plugin>
					<artifactId>maven-clean-plugin</artifactId>
					<version>${maven.clean.plugin.version}</version>
				</plugin>
			</plugins>
		</pluginManagement>
	</build>

	<profiles>
		<!-- mvn -Pformat spotless:apply, kept out of the default build so that it works offline -->
		<profile>
			<id>format</id>
			<build>
				<plugins>
					<plugin>
						<groupId>com.diffplug.spotless</groupId>
						<artifactId>spotless-maven-plugin</artifactId>
						<version>${spotless.version}</version>
						<configuration>
							<java>
								<googleJavaFormat>
									<style>AOSP</style>
								</googleJavaFormat>
								<importOrder>
									<order>org.apache.flink,org.apache.flink.shaded,,javax,java,\#</order>
								</importOrder>
								<removeUnusedImports />
								<licenseHeader>
									<file>${maven.multiModuleProjectDirectory}/spotless.license.java</file>
								</licenseHeader>
							</java>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>
</project>
